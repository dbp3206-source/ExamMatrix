# Copy to .env and replace both values with unique secrets before starting the stack.
# For production, inject these through the platform's secret manager instead of a file.
DB_PASSWORD=replace-with-a-unique-random-64-character-hex-value
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_SECURE_COOKIE=false
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DB_DDL_AUTO=update
JWT_EXPIRATION_MINUTES=120
JWT_REFRESH_WINDOW_MINUTES=30
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=60
